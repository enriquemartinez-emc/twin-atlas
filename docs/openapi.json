{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Explore and manage geospatial digital twins and their annotations.",
    "title" : "Twin Atlas API",
    "version" : "0.0.1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same origin as the API"
  } ],
  "paths" : {
    "/api/scenes" : {
      "get" : {
        "description" : "The 100 newest scenes, newest first.",
        "operationId" : "listScenes",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/SceneResponse"
                  }
                }
              }
            },
            "description" : "Scenes"
          }
        },
        "summary" : "List scenes",
        "tags" : [ "scene-controller" ]
      },
      "post" : {
        "operationId" : "createScene",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateSceneRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SceneResponse"
                }
              }
            },
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "Request shape is invalid"
          }
        },
        "summary" : "Create a scene",
        "tags" : [ "scene-controller" ]
      }
    },
    "/api/scenes/{id}" : {
      "get" : {
        "operationId" : "getScene",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SceneResponse"
                }
              }
            },
            "description" : "The scene"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "NOT_FOUND"
          }
        },
        "summary" : "Get a scene",
        "tags" : [ "scene-controller" ]
      }
    },
    "/api/scenes/{sceneId}/annotations" : {
      "get" : {
        "description" : "Keyset-paginated, ordered by creation time. With `bbox` only annotations that intersect the view are returned. A west value greater than east crosses the antimeridian.",
        "operationId" : "listAnnotations",
        "parameters" : [ {
          "in" : "path",
          "name" : "sceneId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "description" : "west,south,east,north in degrees",
          "in" : "query",
          "name" : "bbox",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50,
            "maximum" : 200,
            "minimum" : 1
          }
        }, {
          "description" : "`nextCursor` of the previous page",
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnnotationPage"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "VALIDATION_FAILED or INVALID_CURSOR"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "SCENE_NOT_FOUND"
          }
        },
        "summary" : "List annotations, or the ones visible in a map view",
        "tags" : [ "annotation-read-endpoints" ]
      },
      "post" : {
        "description" : "Creates a draft marker, note or outline. The ETag is the optimistic-lock version.",
        "operationId" : "createAnnotation",
        "parameters" : [ {
          "in" : "path",
          "name" : "sceneId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateAnnotationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnnotationResponse"
                }
              }
            },
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "Request shape is invalid"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "SCENE_NOT_FOUND"
          },
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "TITLE_ALREADY_USED"
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "INVALID_GEOMETRY or GEOMETRY_OUTSIDE_SCENE_EXTENT"
          }
        },
        "summary" : "Create an annotation in a scene",
        "tags" : [ "create-annotation-endpoint" ]
      }
    },
    "/api/scenes/{sceneId}/annotations/nearest" : {
      "get" : {
        "description" : "Ordered by distance (KNN index scan). `distanceMeters` is geodesic.",
        "operationId" : "nearestAnnotations",
        "parameters" : [ {
          "in" : "path",
          "name" : "sceneId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "query",
          "name" : "longitude",
          "required" : true,
          "schema" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 180.0,
            "minimum" : -180.0
          }
        }, {
          "in" : "query",
          "name" : "latitude",
          "required" : true,
          "schema" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 90.0,
            "minimum" : -90.0
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 10,
            "maximum" : 100,
            "minimum" : 1
          }
        }, {
          "description" : "Only annotations within this radius",
          "in" : "query",
          "name" : "maxDistanceMeters",
          "required" : false,
          "schema" : {
            "type" : "number",
            "format" : "double",
            "exclusiveMinimum" : 0
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NearestAnnotation"
                  }
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "VALIDATION_FAILED"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "SCENE_NOT_FOUND"
          }
        },
        "summary" : "The N annotations closest to a point",
        "tags" : [ "annotation-read-endpoints" ]
      }
    },
    "/api/scenes/{sceneId}/annotations/search" : {
      "post" : {
        "description" : "POST because the zone is a GeoJSON polygon. Keyset-paginated like the list.",
        "operationId" : "searchAnnotations",
        "parameters" : [ {
          "in" : "path",
          "name" : "sceneId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SearchRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnnotationPage"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "VALIDATION_FAILED or INVALID_CURSOR"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "SCENE_NOT_FOUND"
          }
        },
        "summary" : "Annotations that intersect a zone",
        "tags" : [ "annotation-read-endpoints" ]
      }
    },
    "/api/scenes/{sceneId}/annotations/{id}" : {
      "get" : {
        "description" : "The ETag header is the version to send back as If-Match when updating.",
        "operationId" : "getAnnotation",
        "parameters" : [ {
          "in" : "path",
          "name" : "sceneId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnnotationResponse"
                }
              }
            },
            "description" : "OK"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "SCENE_NOT_FOUND or ANNOTATION_NOT_FOUND"
          }
        },
        "summary" : "Get one annotation",
        "tags" : [ "get-annotation-endpoint" ]
      },
      "patch" : {
        "description" : "Send only what changes. Send the ETag you read as If-Match: if the annotation changed since, the answer is 412 and nothing is written. The answer carries the new ETag.",
        "operationId" : "updateAnnotation",
        "parameters" : [ {
          "in" : "path",
          "name" : "sceneId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "description" : "The ETag from the response you read, for example \"3\"",
          "in" : "header",
          "name" : "If-Match",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateAnnotationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnnotationResponse"
                }
              }
            },
            "description" : "Updated"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "VALIDATION_FAILED or REQUEST_INVALID"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "SCENE_NOT_FOUND or ANNOTATION_NOT_FOUND"
          },
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "TITLE_ALREADY_USED or CONCURRENT_MODIFICATION"
          },
          "412" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "STALE_VERSION"
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "INVALID_GEOMETRY, GEOMETRY_OUTSIDE_SCENE_EXTENT, GEOMETRY_KIND_MISMATCH or TEXT_ONLY_FOR_NOTES"
          },
          "428" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "PRECONDITION_REQUIRED: If-Match is missing"
          }
        },
        "summary" : "Rename, retext or move an annotation",
        "tags" : [ "update-annotation-endpoint" ]
      }
    },
    "/api/scenes/{sceneId}/imports/osm" : {
      "post" : {
        "description" : "Turns nodes into markers (notes when they carry a description) and closed ways into outlines. Elements that cannot be imported are reported one by one with a stable code, and do not stop the others. Importing the same extract twice creates nothing the second time. Map data © OpenStreetMap contributors, ODbL.",
        "operationId" : "importOsm",
        "parameters" : [ {
          "in" : "path",
          "name" : "sceneId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OsmImportRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OsmImportResponse"
                }
              }
            },
            "description" : "Processed. Check rejected for elements that were skipped."
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "Request shape is invalid, or more than 5000 elements"
          },
          "404" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description" : "SCENE_NOT_FOUND"
          }
        },
        "summary" : "Import OpenStreetMap elements into a scene",
        "tags" : [ "osm-import-endpoint" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AnnotationPage" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AnnotationSummary"
            }
          },
          "nextCursor" : {
            "type" : [ "string", "null" ],
            "description" : "Pass as `cursor` to get the next page. Null on the last page."
          }
        },
        "required" : [ "items" ]
      },
      "AnnotationResponse" : {
        "type" : "object",
        "properties" : {
          "body" : {
            "type" : [ "string", "null" ],
            "description" : "Only notes carry text"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "geometry" : {
            "$ref" : "#/components/schemas/GeoJsonGeometry"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "MARKER", "NOTE", "OUTLINE" ]
          },
          "sceneId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "status" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "createdAt", "geometry", "id", "kind", "sceneId", "status", "title" ]
      },
      "AnnotationSummary" : {
        "type" : "object",
        "properties" : {
          "body" : {
            "type" : [ "string", "null" ],
            "description" : "Only notes carry text"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "geometry" : {
            "$ref" : "#/components/schemas/GeoJsonGeometry"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "MARKER", "NOTE", "OUTLINE" ]
          },
          "sceneId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "status" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "createdAt", "geometry", "id", "kind", "sceneId", "status", "title" ]
      },
      "Coordinate" : {
        "type" : "object",
        "properties" : {
          "coordinate" : {
            "$ref" : "#/components/schemas/Coordinate",
            "writeOnly" : true
          },
          "m" : {
            "type" : "number",
            "format" : "double"
          },
          "valid" : {
            "type" : "boolean"
          },
          "x" : {
            "type" : "number",
            "format" : "double"
          },
          "y" : {
            "type" : "number",
            "format" : "double"
          },
          "z" : {
            "type" : "number",
            "format" : "double"
          }
        }
      },
      "CoordinateSequence" : {
        "type" : "object",
        "properties" : {
          "dimension" : {
            "type" : "integer",
            "format" : "int32"
          },
          "measures" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "CoordinateSequenceFactory" : { },
      "CreateAnnotationRequest" : {
        "type" : "object",
        "properties" : {
          "body" : {
            "type" : "string",
            "description" : "Required for NOTE, not allowed for the other kinds",
            "maxLength" : 2000,
            "minLength" : 0
          },
          "geometry" : {
            "$ref" : "#/components/schemas/GeoJsonGeometry"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "MARKER", "NOTE", "OUTLINE" ]
          },
          "title" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          }
        },
        "required" : [ "geometry", "kind", "title" ]
      },
      "CreateSceneRequest" : {
        "type" : "object",
        "properties" : {
          "extent" : {
            "$ref" : "#/components/schemas/GeoJsonPolygon"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          }
        },
        "required" : [ "extent", "name" ]
      },
      "Element" : {
        "type" : "object",
        "properties" : {
          "geometry" : {
            "type" : "array",
            "description" : "Points of a way, as produced by out geom",
            "items" : {
              "$ref" : "#/components/schemas/Point"
            }
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "lat" : {
            "type" : "number",
            "format" : "double",
            "description" : "Latitude of a node"
          },
          "lon" : {
            "type" : "number",
            "format" : "double",
            "description" : "Longitude of a node"
          },
          "tags" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "type" : {
            "type" : "string",
            "description" : "node, way or relation",
            "minLength" : 1
          }
        },
        "required" : [ "id", "type" ]
      },
      "Envelope" : {
        "type" : "object",
        "properties" : {
          "area" : {
            "type" : "number",
            "format" : "double"
          },
          "diameter" : {
            "type" : "number",
            "format" : "double"
          },
          "height" : {
            "type" : "number",
            "format" : "double"
          },
          "maxX" : {
            "type" : "number",
            "format" : "double"
          },
          "maxY" : {
            "type" : "number",
            "format" : "double"
          },
          "minX" : {
            "type" : "number",
            "format" : "double"
          },
          "minY" : {
            "type" : "number",
            "format" : "double"
          },
          "null" : {
            "type" : "boolean"
          },
          "width" : {
            "type" : "number",
            "format" : "double"
          }
        }
      },
      "GeoJsonGeometry" : {
        "description" : "A GeoJSON geometry the API accepts: Point or Polygon",
        "discriminator" : {
          "mapping" : {
            "Point" : "#/components/schemas/GeoJsonPoint",
            "Polygon" : "#/components/schemas/GeoJsonPolygon"
          },
          "propertyName" : "type"
        },
        "oneOf" : [ {
          "$ref" : "#/components/schemas/GeoJsonPoint"
        }, {
          "$ref" : "#/components/schemas/GeoJsonPolygon"
        } ]
      },
      "GeoJsonPoint" : {
        "type" : "object",
        "description" : "A single position",
        "properties" : {
          "coordinates" : {
            "type" : "array",
            "description" : "[longitude, latitude] or [longitude, latitude, height] in WGS 84",
            "items" : {
              "type" : "number"
            },
            "maxItems" : 3,
            "minItems" : 2
          },
          "type" : {
            "type" : "string",
            "enum" : [ "Point" ]
          }
        },
        "required" : [ "coordinates", "type" ]
      },
      "GeoJsonPolygon" : {
        "type" : "object",
